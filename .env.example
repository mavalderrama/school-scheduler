# Copiar a .env y completar. Nunca subir .env al repo.

TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=111111111,222222222       # obtenerlos con @userinfobot
ALLOWED_CHAT_IDS=-1001234567890,111111111,222222222   # grupo + privados
NOTIFY_CHAT_IDS=-1001234567890

# --- Selección de proveedor por tarea ---
# Cambiar de proveedor es solo cambiar estas variables (ollama | claude_sdk | anthropic_api).
LLM_VISION_PROVIDER=claude_sdk
LLM_TEXT_PROVIDER=claude_sdk
LLM_VISION_FALLBACK=none                   # none | ollama | claude_sdk | anthropic_api
LLM_TEXT_FALLBACK=none
LLM_VISION_TIMEOUT=180
LLM_TEXT_TIMEOUT=60
LLM_RETRY_AFTER_MIN=60                     # reencolar tras error de cuota

# --- Ollama (solo si algún proveedor es ollama) ---
OLLAMA_BASE_URL=                           # p. ej. http://10.0.0.20:11434
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_TEXT_MODEL=qwen3:8b

# --- Claude vía suscripción (Agent SDK) ---
CLAUDE_CODE_OAUTH_TOKEN=                   # salida de `claude setup-token` (caduca al año)
CLAUDE_TOKEN_ISSUED_AT=                    # YYYY-MM-DD, para que /estado avise del vencimiento
CLAUDE_SDK_MODEL=sonnet                    # sonnet | opus
CLAUDE_SDK_MAX_TURNS=4

# --- Claude por API key (pago por uso) ---
ANTHROPIC_API_KEY=                         # NO definirla si quieres usar la suscripción
ANTHROPIC_API_MODEL=claude-sonnet-4-6      # verificar ID vigente en la consola

# --- Infra ---
DATABASE_URL=postgresql+asyncpg://agenda:agenda@postgres:5432/agenda
POSTGRES_USER=agenda                       # deben coincidir con DATABASE_URL
POSTGRES_PASSWORD=agenda
POSTGRES_DB=agenda
DATA_DIR=/data
TZ=America/Bogota
DAILY_NOTIFY_TIME=19:00
GAP_CHECK_TIME=18:00
SKIP_WEEKEND=true
LOG_LEVEL=INFO
LOG_FORMAT=json                            # json | console

# Target del Dockerfile: with-claude (incluye el binario de Claude Code) | base (solo ollama/api)
BOT_IMAGE_TARGET=with-claude
