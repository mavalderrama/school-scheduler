# Copiar a .env y completar. Nunca subir .env al repo.

TELEGRAM_BOT_TOKEN=
ALLOWED_USER_IDS=111111111,222222222       # obtenerlos con @userinfobot
ALLOWED_CHAT_IDS=-1001234567890,111111111,222222222   # grupo + privados
NOTIFY_CHAT_IDS=-1001234567890

# --- Selección de proveedor por tarea ---
# Cambiar de proveedor es solo cambiar estas variables (ollama | claude_sdk | anthropic_api).
LLM_VISION_PROVIDER=claude_sdk
LLM_TEXT_PROVIDER=claude_sdk
LLM_VISION_FALLBACK=none                   # none | ollama | claude_sdk | anthropic_api
LLM_TEXT_FALLBACK=none
LLM_VISION_TIMEOUT=180
LLM_TEXT_TIMEOUT=60
LLM_RETRY_AFTER_MIN=60                     # reencolar tras error de cuota

# --- Caché de respuestas del LLM ---
# Coincidencia exacta: la misma foto (o la misma consulta) el mismo día no gasta tokens.
# La clave incluye la fecha y la versión de los prompts, así que nada se queda obsoleto.
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_DAYS=30

# --- Robustez ---
PHOTO_RETENTION_DAYS=90                    # borra el archivo de fotos ya confirmadas
RETRY_GIVE_UP_HOURS=24                     # tras esto, deja de reintentar una foto

# --- Ollama (solo si algún proveedor es ollama) ---
# p. ej. http://10.0.0.20:11434
OLLAMA_BASE_URL=
OLLAMA_VISION_MODEL=qwen3-vl:8b
OLLAMA_TEXT_MODEL=qwen3:8b

# --- Claude vía suscripción (Agent SDK) ---
# salida de `claude setup-token` (caduca al año)
CLAUDE_CODE_OAUTH_TOKEN=
# YYYY-MM-DD, para que /estado avise del vencimiento
CLAUDE_TOKEN_ISSUED_AT=
CLAUDE_SDK_MODEL=sonnet                    # sonnet | opus
CLAUDE_SDK_MAX_TURNS=4

# --- Claude por API key (pago por uso) ---
# NO definirla si quieres usar la suscripción
ANTHROPIC_API_KEY=
ANTHROPIC_API_MODEL=claude-sonnet-4-6      # verificar ID vigente en la consola

# --- Infra ---
DATABASE_URL=postgresql://agenda:agenda@postgres:5432/agenda
POSTGRES_USER=agenda                       # deben coincidir con DATABASE_URL
POSTGRES_PASSWORD=agenda
POSTGRES_DB=agenda
DATA_DIR=/data
TZ=America/Bogota
DAILY_NOTIFY_TIME=19:00
GAP_CHECK_TIME=18:00
SKIP_WEEKEND=true

# --- Horario rotativo y calendario escolar (Fase 6) ---
# Con SCHEDULE_ENABLED=true el bot calcula qué clase toca cada día a partir de la tabla
# del horario (Semana A / Semana B) y salta los días no lectivos.
SCHEDULE_ENABLED=true
# País para los festivos nacionales (librería `holidays`, código ISO de dos letras).
# Los días sin clase que solo conoce el colegio se cargan en el admin, en
# «excepciones del calendario».
SCHOOL_COUNTRY=CO

# --- Trazas de las llamadas al LLM ---
# Guarda el prompt enviado y la respuesta cruda en `llm_calls`, visibles en el admin.
# Es lo que permite ver por qué falló una llamada, no solo que falló.
LLM_TRACE_ENABLED=true
LLM_TRACE_RETENTION_DAYS=30
# OpenTelemetry (opcional): Langfuse autoalojado y compañía ingieren OTLP. Requiere el
# extra `otel` en la imagen. El endpoint sale de OTEL_EXPORTER_OTLP_ENDPOINT.
OTEL_ENABLED=false
OTEL_SERVICE_NAME=agenda-escolar-bot
# OTEL_EXPORTER_OTLP_ENDPOINT=http://langfuse:3000/api/public/otel
LOG_LEVEL=INFO
LOG_FORMAT=json                            # json | console

# --- Admin web (Django, solo LAN) ---
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*                     # separados por coma; p. ej. 192.168.1.50,agenda.lan
# solo detrás de un proxy, con esquema: http://agenda.lan:8000
DJANGO_CSRF_TRUSTED_ORIGINS=
ADMIN_ENABLED=true                         # false = el proceso no levanta el servidor HTTP
ADMIN_HOST=0.0.0.0                         # interfaz dentro del contenedor
ADMIN_PORT=8000
ADMIN_BIND=0.0.0.0                         # IP del host donde compose publica el puerto (solo LAN)
# se crea en arranque si no existe; la clave no se reescribe
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=

# Target del Dockerfile: with-claude (incluye el binario de Claude Code) | base (solo ollama/api)
BOT_IMAGE_TARGET=with-claude
